# -*- coding: utf-8 -*-
# نموذج /etc/csit/api.env — نشر بلا Docker على سيرفر الجامعة.
#
#   sudo install -d -m 750 /etc/csit
#   sudo install -m 600 -o root -g root /opt/csit/deploy/api.env.example /etc/csit/api.env
#   sudo nano /etc/csit/api.env
#
# القيم أدناه نائبة فقط وليست صالحة للتشغيل — استبدلها كلها قبل التشغيل.
# systemd يقرأ هذا الملف حرفياً: لا توسيع لمتغيّرات $، ولا معالجة لعلامات الاقتباس.
# اكتب KEY=value بلا مسافات حول =، وسطر واحد لكل متغيّر.
# الصلاحية 600 ومالكه root: systemd (PID 1) يقرأه ثم يمرّر المتغيّرات للخدمة،
# لذا لا يحتاج مستخدم csit قراءة الملف — لا توسّع صلاحياته.

# ---------- قاعدة البيانات المحلية (PostgreSQL على 127.0.0.1) ----------
# كلمة المرور تُركَّب داخل رابط: استخدم أحرفاً آمنة، أو %-encode للمحارف @ : / ? # $ %
DATABASE_URL=postgresql+psycopg://csit:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/csit

# ---------- المصادقة ----------
# وَلّد قيمة حقيقية: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# لا تعِد استخدام قيمة المثال: تسريبها يعني القدرة على تزوير رموز JWT.
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_FROM_SECRETS_MODULE

# ---------- الواجهة ----------
# نطاقات مسموح لها بـCORS (تعبير نمطي). لوحة التحكم تُخدَم من نفس الأصل عبر Nginx
# فلا تحتاج CORS؛ أبقِ القيمة لنطاق الويب/التطوير فقط. استخدم [.] بدل \. كي لا
# يفسّرها parser في systemd كتسلسل هروب.
CORS_ORIGIN_REGEX=https://csit[.]example[.]edu[.]iq

# ---------- الملفات المرفوعة ----------
# مجلد دائم قابل للكتابة لمستخدم csit (وليس داخل /tmp) — يبقى بعد إعادة التشغيل
UPLOAD_DIR=/opt/csit/api/uploads

# ---------- Redis (اختياري) ----------
# اتركه فارغاً = عدّاد حدّ المعدل في الذاكرة (مناسب لنسخة خدمة واحدة كما هنا)
REDIS_URL=
