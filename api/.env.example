# عنوان قاعدة البيانات — محلياً SQLite افتراضياً بلا إعداد.
# على السيرفر الجامعي (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://csit:PASSWORD@localhost:5432/csit

# سرّ الهوية الرقمية (بطاقة QR الموقّعة) — مستقل عن JWT
# IDENTITY_SECRET=<64 حرفاً عشوائياً>

# إشعارات الدفع — انظر docs/RUNBOOK.md قبل التفعيل
# FCM_ENABLED=true
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# FCM_CREDENTIALS_FILE=
