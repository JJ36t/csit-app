# -*- coding: utf-8 -*-
# نموذج متغيرات النشر — انسخه إلى .env ثم استبدل كل القيم النائبة.
#   Copy-Item .env.example .env      (PowerShell)
# ملف .env مستثنى في .gitignore: لا تُودِع أسراراً.
# القيم أدناه نائبة فقط وليست صالحة للتشغيل.

# ---------- قاعدة البيانات (خدمة db) ----------
POSTGRES_DB=csit
POSTGRES_USER=csit
# كلمة المرور تُركَّب داخل رابط اتصال: استخدم أحرفاً آمنة (بلا مسافات ولا @ : / ? # $ %)
POSTGRES_PASSWORD=replace-with-strong-db-password

# ---------- الخدمة (api) ----------
# سرّ توقيع JWT — وَلّد واحداً بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-jwt-secret
# Redis اختياري لحدّ المعدل عبر عدة نسخ؛ اتركه فارغاً = عدّاد في الذاكرة.
# لتفعيله داخل compose:
#   docker compose --profile redis up -d
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=
RATE_LIMIT_ENABLED=true

# ---------- الواجهة (admin/Nginx) ----------
# منفذ النشر على المضيف؛ يُوضع Caddy/HTTPS أمامه في خطوة لاحقة
HTTP_PORT=8080
# واجهة الاستماع: 127.0.0.1 (آمن افتراضياً) أو 0.0.0.0 خلف جدار ناري
HTTP_BIND=127.0.0.1
