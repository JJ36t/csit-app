# -*- coding: utf-8 -*-
# نموذج متغيرات النشر — انسخه إلى .env ثم استبدل كل القيم النائبة.
#   Copy-Item .env.example .env      (PowerShell)
# ملف .env مستثنى في .gitignore: لا تُودِع أسراراً.
# القيم أدناه نائبة فقط وليست صالحة للتشغيل.

# ---------- قاعدة البيانات (خدمة db) ----------
POSTGRES_DB=csit
POSTGRES_USER=csit
# كلمة المرور تُركَّب داخل رابط اتصال: استخدم أحرفاً آمنة (بلا مسافات ولا @ : / ? # $ %)
POSTGRES_PASSWORD=replace-with-strong-db-password

# ---------- الخدمة (api) ----------
# سرّ توقيع JWT — وَلّد واحداً بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-jwt-secret
# Redis اختياري لحدّ المعدل عبر عدة نسخ؛ اتركه فارغاً = عدّاد في الذاكرة
REDIS_URL=
RATE_LIMIT_ENABLED=true

# ---------- الواجهة (admin/Nginx) ----------
# منفذ النشر على المضيف؛ يُوضع Caddy/HTTPS أمامه في خطوة لاحقة
HTTP_PORT=8080

# ---------- الهوية الرقمية ----------
# سرّ توقيع بطاقات QR — مستقل عن JWT كي لا يكشف تدوير أحدهما الآخر
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IDENTITY_SECRET=
IDENTITY_CARD_TTL_SECONDS=180

# ---------- إشعارات الدفع FCM (اختياري) ----------
# اتركها false حتى تجهز مشروع Firebase وحساب الخدمة (انظر docs/RUNBOOK.md)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# المفتاح الخاص كاملاً بأسطر \n مهرّبة، أو ضع الملف واستخدم FCM_CREDENTIALS_FILE
FCM_PRIVATE_KEY=
FCM_CREDENTIALS_FILE=
PUSH_DISPATCH_ENABLED=true
